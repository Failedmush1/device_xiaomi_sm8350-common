<?xml version="1.0" encoding="utf-8" ?>
<MediaCodecs>
    <Include href="media_codecs_google_audio.xml" />
    <Include href="media_codecs_dolby_audio.xml" />
    <Include href="media_codecs_vendor_audio.xml" />
    <Include href="media_codecs_google_telephony.xml" />
    <Include href="media_codecs_c2_audio.xml" />
    
    <Include href="media_codecs_system_default_shima.xml" />
    <Include href="media_codecs_with_dolby_shima.xml" />
    <Include href="media_codecs_performance_shima_v2.xml" />
    
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="11" />
    </Settings>

    <Decoders>
        <MediaCodec name="c2.qti.hevc.decoder" type="video/hevc">
            <Limit name="size" min="96x96" max="4096x2176" />
            <Limit name="bitrate" range="1-100000000" />
            <Limit name="profile" value="1,2" /> <Limit name="level" value="1,2,4,8,16,32,64,128,256,512,1024,2048,4096,8192" />
            <Feature name="adaptive-playback" />
            <Feature name="can-swap-width-height" value="1" />
        </MediaCodec>
    </Decoders>

    <Encoders>
        <MediaCodec name="c2.qti.hevc.encoder" type="video/hevc">
            <Limit name="size" min="96x96" max="4096x2176" />
            <Limit name="bitrate" range="1-160000000" />
            <Limit name="profile" value="1,2" />
            <Feature name="can-swap-width-height" value="1" />
        </MediaCodec>
    </Encoders>
</MediaCodecs>
