type vendor_touchfeature_device, dev_type;

allow hal_power_default vendor_touchfeature_device:chr_file rw_file_perms;

# Allow hal_power_default to talk to vendor_hal_perf_default
allow hal_power_default vendor_hal_perf_default:binder call;
allow hal_power_default vendor_hal_perf_hwservice:hwservice_manager find;

allow hal_power_default proc:file { open write };
